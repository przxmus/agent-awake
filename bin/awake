#!/bin/bash
# awake: keep the Mac awake (lid closed too) while any AI agent session is working.
#
# Every working session holds a lock file in $AWAKE_HOME/locks. While at least one
# lock exists, `pmset disablesleep 1` is set; when the last one goes away, the state
# from before the first lock is restored. Locks of dead agent processes or without a heartbeat for
# AWAKE_TTL_MIN minutes are swept (run `awake sweep` from launchd every minute).

set -u

AWAKE_HOME="${AWAKE_HOME:-$HOME/.agent-awake}"
LOCKS="$AWAKE_HOME/locks"
LOG="$AWAKE_HOME/awake.log"
MUTEX="$AWAKE_HOME/.mutex"
OWNED="$AWAKE_HOME/owned"
PAUSED="$AWAKE_HOME/paused"
# Overridable for tests; the sudoers rule must match the real pmset path.
PMSET="${AWAKE_PMSET:-/usr/bin/pmset}"
SUDO="${AWAKE_SUDO-sudo -n}"
AWAKE_TTL_MIN=45
# shellcheck source=/dev/null
[ -f "$AWAKE_HOME/config" ] && . "$AWAKE_HOME/config"

mkdir -p "$LOCKS"

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"
}

lock_mutex() {
  local i=0
  until mkdir "$MUTEX" 2>/dev/null; do
    i=$((i + 1))
    # A holder that died mid-run leaves the mutex behind; steal it after ~5s.
    if [ "$i" -ge 50 ]; then
      rm -rf "$MUTEX"
      i=0
    fi
    sleep 0.1
  done
  trap 'rmdir "$MUTEX" 2>/dev/null' EXIT
}

# Safe as a file name: letters, digits, dot, dash, underscore.
sanitize() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

# Walk up the process tree to the agent binary (claude / codex) that ran this hook.
agent_pid() {
  local pid=$PPID comm ppid
  while [ "$pid" -gt 1 ]; do
    read -r ppid comm < <(ps -o ppid= -o comm= -p "$pid" 2>/dev/null) || break
    case "$(basename "$comm" | tr '[:upper:]' '[:lower:]')" in
      claude* | codex*) echo "$pid"; return ;;
    esac
    pid=$ppid
  done
  echo 0
}

current_state() {
  "$PMSET" -g | awk '/SleepDisabled/ { print $2 }'
}

set_sleep() {
  # shellcheck disable=SC2086 # $SUDO is a command prefix and may be empty.
  if $SUDO "$PMSET" disablesleep "$1" 2>>"$LOG"; then
    log "disablesleep $1 ($2)"
  else
    log "ERROR: sudo pmset disablesleep $1 failed (is the sudoers entry installed?)"
    return 1
  fi
}

# Paused while $PAUSED exists; its content is the epoch it ends at (0 = until resume).
# An expired pause is removed here, so it ends on the next hook or sweep.
is_paused() {
  local until
  [ -f "$PAUSED" ] || return 1
  until=$(cat "$PAUSED" 2>/dev/null)
  if [ "${until:-0}" -gt 0 ] && [ "$(date +%s)" -ge "$until" ]; then
    rm -f "$PAUSED"
    log "pause expired"
    return 1
  fi
  return 0
}

# Sync pmset with the locks. awake only undoes what it did itself: if sleep was
# already disabled before the first lock (by you or another tool), it stays that way
# after the last lock goes. $OWNED marks that awake is the one who disabled it.
apply() {
  local count have
  count=$(find "$LOCKS" -type f | wc -l | tr -d ' ')
  # Locks keep being tracked while paused, but sleep is left alone.
  is_paused && count=0
  have=$(current_state)
  if [ "$count" -gt 0 ]; then
    [ "$have" = 1 ] && return
    set_sleep 1 "locks: $count" && touch "$OWNED"
  elif [ -f "$OWNED" ]; then
    if [ "$have" = 1 ]; then
      set_sleep 0 "no locks left" || return
    fi
    rm -f "$OWNED"
  fi
}

cmd_on() {
  local id pid
  id=$(sanitize "${1:-manual}")
  pid="${2:-0}"
  lock_mutex
  [ -f "$LOCKS/$id" ] || log "on  $id (pid $pid)"
  printf 'pid=%s\nsince=%s\n' "$pid" "$(date +%s)" >"$LOCKS/$id"
  apply
}

cmd_off() {
  local id
  id=$(sanitize "${1:-manual}")
  lock_mutex
  [ -f "$LOCKS/$id" ] && log "off $id"
  rm -f "$LOCKS/$id"
  apply
}

cmd_sweep() {
  local f id pid now mtime
  now=$(date +%s)
  lock_mutex
  for f in "$LOCKS"/*; do
    [ -f "$f" ] || continue
    id=$(basename "$f")
    [ "$id" = manual ] && continue
    pid=$(sed -n 's/^pid=//p' "$f")
    mtime=$(stat -f %m "$f")
    if [ "${pid:-0}" -gt 0 ] && ! ps -p "$pid" >/dev/null 2>&1; then
      log "sweep $id (process $pid is gone)"
      rm -f "$f"
    elif [ $((now - mtime)) -gt $((AWAKE_TTL_MIN * 60)) ]; then
      log "sweep $id (no heartbeat for ${AWAKE_TTL_MIN}m)"
      rm -f "$f"
    fi
  done
  apply
}

# Parse "30", "30m", "2h" into minutes; prints nothing on bad input.
parse_minutes() {
  case "$1" in
    *[!0-9mh]* | "" | m | h) return 1 ;;
    *h) echo $((${1%h} * 60)) ;;
    *m) echo "${1%m}" ;;
    *) echo "$1" ;;
  esac
}

cmd_pause() {
  local mins until=0
  if [ -n "${1:-}" ]; then
    mins=$(parse_minutes "$1") || { echo "awake: bad duration '$1' (use e.g. 30, 30m, 2h)" >&2; exit 1; }
    until=$(($(date +%s) + mins * 60))
  fi
  lock_mutex
  echo "$until" >"$PAUSED"
  log "pause (${1:-until resume})"
  apply
  if [ "$until" -gt 0 ]; then echo "paused for $1"; else echo "paused until 'awake resume'"; fi
}

cmd_resume() {
  lock_mutex
  rm -f "$PAUSED"
  log "resume"
  apply
  echo "resumed"
}

cmd_status() {
  local f now
  now=$(date +%s)
  echo "SleepDisabled: $(current_state)"
  if is_paused; then
    if [ "$(cat "$PAUSED")" -gt 0 ]; then
      echo "Paused: yes, $((($(cat "$PAUSED") - now + 59) / 60))m left (awake resume to end)"
    else
      echo "Paused: yes (awake resume to end)"
    fi
  fi
  if [ -f "$OWNED" ]; then
    echo "Set by awake: yes (restored when the last lock goes)"
  else
    echo "Set by awake: no (left as is)"
  fi
  echo "Locks:"
  for f in "$LOCKS"/*; do
    [ -f "$f" ] || { echo "  (none)"; break; }
    printf '  %s  pid=%s  last beat %ss ago\n' "$(basename "$f")" \
      "$(sed -n 's/^pid=//p' "$f")" $((now - $(stat -f %m "$f")))
  done
}

cmd_reset() {
  lock_mutex
  rm -f "$LOCKS"/*
  log "reset"
  apply
}

# Hook entry point: `awake hook <claude|codex> <on|off>`, hook JSON on stdin.
# Never prints and always exits 0, so it can't block or break the agent.
cmd_hook() {
  local tool action input sid
  tool=$1
  action=$2
  input=$(cat)
  sid=$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
  [ -n "$sid" ] || sid=unknown
  case "$action" in
    on) cmd_on "$tool-$sid" "$(agent_pid)" ;;
    off) cmd_off "$tool-$sid" ;;
  esac
}

# The repo checkout this script lives in (bin/awake is usually reached via a symlink).
repo_root() {
  local self
  self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
  cd "$(dirname "$self")/.." && pwd
}

cmd_version() {
  local root sha
  root=$(repo_root)
  sha=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || true)
  echo "agent-awake $(cat "$root/VERSION")${sha:+ ($sha)}"
}

cmd_update() {
  local root
  root=$(repo_root)
  if ! git -C "$root" pull --ff-only; then
    echo "awake: update failed; commit or stash local changes in $root and retry" >&2
    exit 1
  fi
  exec "$root/install.sh"
}

usage() {
  cat <<EOF
usage: awake status           show sleep state and locks
       awake on [id] [pid]    hold a lock (default id: manual, never swept);
                              with a pid, the lock dies with that process
       awake off [id]         release a lock
       awake pause [30m|2h]   stop keeping the Mac awake (locks are still tracked);
                              without a duration, until 'awake resume'
       awake resume           end the pause
       awake reset            drop all locks and restore the previous sleep state
       awake update           pull the latest version and reinstall
       awake uninstall        remove hooks, launchd job and the awake command
       awake version          print the installed version
       awake sweep            drop stale locks, then sync pmset (run by launchd)
       awake hook TOOL on|off agent hook entry point, reads hook JSON on stdin
EOF
}

case "${1:-}" in
  on) cmd_on "${2:-}" "${3:-0}" ;;
  off) cmd_off "${2:-}" ;;
  sweep) cmd_sweep ;;
  status) cmd_status ;;
  pause) cmd_pause "${2:-}" ;;
  resume) cmd_resume ;;
  reset) cmd_reset ;;
  update) cmd_update ;;
  uninstall) exec "$(repo_root)/uninstall.sh" ;;
  version | --version | -v) cmd_version ;;
  help | --help | -h) usage ;;
  hook) cmd_hook "${2:-}" "${3:-}" >/dev/null 2>&1; exit 0 ;;
  *) usage; exit 1 ;;
esac
